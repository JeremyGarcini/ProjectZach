# macOS
.DS_Store

# Xcode — per-user state. Window positions, breakpoints, last open file.
# Noise in a diff, and it leaks your local paths.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build products
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.hmap
*.o

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Fastlane / CI, if it ever shows up
fastlane/report.xml
fastlane/screenshots

# Test results
*.xcresult

# NOTE — deliberately NOT ignored:
#   Persona.xcodeproj/            generated by XcodeGen from project.yml, but
#                                 committed so a reviewer can open the project
#                                 without installing anything.
#   *.xcodeproj/xcshareddata/     holds the shared `Persona` scheme. Without it
#                                 `xcodebuild -scheme Persona` fails for everyone
#                                 but you, and the project opens with no scheme.
